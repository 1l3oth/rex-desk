{
  "name": "rex-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local, chat-first desk where AI agents work on your projects with you: personal chats, group rooms and tasks",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"test/*.test.js\"",
    "mcp": "node src/stdio.js",
    "verify": "node scripts/verify.js",
    "test:browser": "node scripts/browser-test.js",
    "jev": "node bin/jev.js",
    "jev:anywhere": "powershell -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File scripts/jev-anywhere.ps1"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.0",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "codemirror": "^5.65.18",
    "driver.js": "^1.14.0",
    "mammoth": "^1.8.0",
    "msedge-tts": "^2.1.1",
    "playwright": "^1.0.0",
    "prettier": "^3.3.3",
    "qrcode": "^1.5.4",
    "three": "0.186.1",
    "xlsx": "^0.18.5",
    "zod": "^4.0.0"
  },
  "bin": {
    "jev": "bin/jev.js"
  }
}
