    { "id": "linear", "name": "Linear", "group": "work", "icon": "color/linear.svg", "tier": "mcp", "phase": 1, "verified": true, "connect": { "kind": "remote-mcp", "auth": "oauth", "url": "https://mcp.linear.app/mcp", "fields": [], "helpUrl": "https://linear.app/docs/mcp", "source": "https://linear.app/docs/mcp" } },
    { "id": "atlassian", "name": "Jira and Confluence", "group": "work", "icon": "color/jira.svg", "tier": "mcp", "phase": 1, "verified": false, "note": "Atlassian Cloud only. Some actions use Rovo credits.", "connect": { "kind": "remote-mcp", "auth": "oauth", "url": "https://mcp.atlassian.com/v2/mcp", "fields": [], "helpUrl": "https://support.atlassian.com/atlassian-rovo-mcp-server/docs/getting-started-with-the-atlassian-remote-mcp-server/", "source": "https://support.atlassian.com/atlassian-rovo-mcp-server/docs/getting-started-with-the-atlassian-remote-mcp-server/" } },
    { "id": "clickup", "name": "ClickUp", "group": "work", "icon": "color/clickup.svg", "tier": "mcp", "phase": 1, "verified": true, "note": "Sign-in only; ClickUp caps calls per day by plan.", "connect": { "kind": "remote-mcp", "auth": "oauth", "url": "https://mcp.clickup.com/mcp", "fields": [], "helpUrl": "https://developer.clickup.com/docs/connect-an-ai-assistant-to-clickups-mcp-server", "source": "https://developer.clickup.com/docs/connect-an-ai-assistant-to-clickups-mcp-server" } },
    { "id": "trello", "name": "Trello", "group": "work", "icon": "color/trello.svg", "tier": "send", "phase": 1, "verified": true, "note": "A key and a token. No task sync.", "connect": { "kind": "token", "auth": "none", "fields": ["apiKey", "token"], "helpUrl": "https://trello.com/apps/admin", "source": "https://developer.atlassian.com/cloud/trello/guides/rest-api/authorization/" } },
    { "id": "asana", "name": "Asana", "group": "work", "icon": "color/asana.svg", "tier": "mcp", "phase": 2, "verified": true, "note": "Needs a Rex Desk app registered with Asana.", "connect": { "kind": "remote-mcp", "auth": "oauth", "url": "https://mcp.asana.com/v2/mcp", "fields": [], "helpUrl": "https://developers.asana.com/docs/using-asanas-mcp-server", "source": "https://developers.asana.com/docs/using-asanas-mcp-server" } },

    { "id": "discord", "name": "Discord", "group": "chat", "icon": "color/discord.svg", "tier": "send", "phase": 1, "verified": true, "note": "Send only, to one channel.", "connect": { "kind": "webhook", "auth": "none", "fields": ["webhookUrl"], "helpUrl": "https://support.discord.com/hc/en-us/articles/228383668", "source": "https://docs.discord.com/developers/resources/webhook" } },
    { "id": "telegram", "name": "Telegram", "group": "chat", "icon": "color/telegram.svg", "tier": "send", "phase": 1, "verified": true, "note": "A bot token from @BotFather.", "connect": { "kind": "token", "auth": "none", "fields": ["botToken"], "helpUrl": "https://t.me/BotFather", "source": "https://core.telegram.org/bots" } },
    { "id": "slack", "name": "Slack", "group": "chat", "icon": "color/slack.svg", "tier": "mcp", "phase": 2, "verified": true, "note": "Needs a Rex Desk Slack app; Slack has no open sign-in for new apps.", "connect": { "kind": "remote-mcp", "auth": "oauth", "url": "https://mcp.slack.com/mcp", "fields": [], "helpUrl": "https://docs.slack.dev/ai/slack-mcp-server/", "source": "https://docs.slack.dev/ai/slack-mcp-server/" } },
    { "id": "teams", "name": "Microsoft Teams", "group": "chat", "icon": "color/teams.svg", "tier": "send", "phase": 2, "verified": false, "note": "Through a Workflows webhook; the old connectors are being retired.", "connect": { "kind": "webhook", "auth": "none", "fields": ["webhookUrl"], "helpUrl": "https://devblogs.microsoft.com/microsoft365dev/retirement-of-office-365-connectors-within-microsoft-teams/", "source": "https://devblogs.microsoft.com/microsoft365dev/retirement-of-office-365-connectors-within-microsoft-teams/" } },

    { "id": "github", "name": "GitHub", "group": "code", "icon": "github.svg", "tier": "mcp", "phase": 1, "verified": true, "note": "A personal access token.", "connect": { "kind": "remote-mcp", "auth": "header", "url": "https://api.githubcopilot.com/mcp/", "fields": ["token"], "helpUrl": "https://github.com/settings/personal-access-tokens", "source": "https://docs.github.com/en/copilot/how-tos/context/model-context-protocol/using-the-github-mcp-server" } },
    { "id": "gitlab", "name": "GitLab", "group": "code", "icon": "color/gitlab.svg", "tier": "mcp", "phase": 1, "verified": true, "note": "Sign in, or paste a fine-grained token.", "connect": { "kind": "remote-mcp", "auth": "oauth", "url": "https://gitlab.com/api/v4/mcp", "fields": ["host", "token?"], "helpUrl": "https://gitlab.com/-/user_settings/personal_access_tokens", "source": "https://docs.gitlab.com/user/gitlab_duo/model_context_protocol/mcp_server/" } },
    { "id": "bitbucket", "name": "Bitbucket", "group": "code", "icon": "color/bitbucket.svg", "tier": "send", "phase": 2, "verified": true, "connect": { "kind": "token", "auth": "header", "fields": ["token"], "helpUrl": "https://support.atlassian.com/bitbucket-cloud/docs/using-access-tokens/", "source": "https://support.atlassian.com/bitbucket-cloud/docs/using-access-tokens/" } },

    { "id": "notion", "name": "Notion", "group": "docs", "icon": "notion.svg", "tier": "mcp", "phase": 1, "verified": true, "connect": { "kind": "remote-mcp", "auth": "oauth", "url": "https://mcp.notion.com/mcp", "fields": [], "helpUrl": "https://developers.notion.com/docs/mcp", "source": "https://developers.notion.com/docs/mcp" } },
    { "id": "dropbox", "name": "Dropbox", "group": "docs", "icon": "color/dropbox.svg", "tier": "mcp", "phase": 1, "verified": true, "connect": { "kind": "remote-mcp", "auth": "oauth", "url": "https://mcp.dropbox.com/mcp", "fields": [], "helpUrl": "https://help.dropbox.com/integrations/connect-dropbox-mcp-server", "source": "https://help.dropbox.com/integrations/connect-dropbox-mcp-server" } },
    { "id": "googledrive", "name": "Google Drive", "group": "docs", "icon": "color/googledrive.svg", "tier": "mcp", "phase": 2, "verified": false, "note": "Needs a Google Cloud app for Rex Desk.", "connect": { "kind": "remote-mcp", "auth": "oauth", "url": "https://drivemcp.googleapis.com/mcp/v1", "fields": [], "helpUrl": "https://developers.google.com/workspace/drive/api/guides/configure-mcp-server", "source": "https://developers.google.com/workspace/drive/api/guides/configure-mcp-server" } },
    { "id": "filesystem", "name": "Folders on this computer", "group": "docs", "icon": "folder.svg", "tier": "mcp", "phase": 1, "verified": true, "note": "Do not share folders other people on this computer can write to.", "connect": { "kind": "local-mcp", "auth": "none", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "{folder}"], "fields": ["folder"], "helpUrl": "https://github.com/modelcontextprotocol/servers/tree/main/src/filesystem", "source": "https://github.com/modelcontextprotocol/servers/tree/main/src/filesystem" } },

