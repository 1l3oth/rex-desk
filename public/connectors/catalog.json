    { "id": "figma", "name": "Figma", "group": "tools", "icon": "color/figma.svg", "tier": "mcp", "phase": 1, "verified": true, "connect": { "kind": "remote-mcp", "auth": "oauth", "url": "https://mcp.figma.com/mcp", "fields": [], "helpUrl": "https://developers.figma.com/docs/figma-mcp-server/remote-server-installation", "source": "https://developers.figma.com/docs/figma-mcp-server/remote-server-installation" } },
    { "id": "vercel", "name": "Vercel", "group": "tools", "icon": "vercel.svg", "tier": "mcp", "phase": 1, "verified": true, "note": "Vercel lets only approved apps sign in.", "connect": { "kind": "remote-mcp", "auth": "oauth", "url": "https://mcp.vercel.com", "fields": [], "helpUrl": "https://vercel.com/docs/agent-resources/vercel-mcp", "source": "https://vercel.com/docs/agent-resources/vercel-mcp" } },
    { "id": "stripe", "name": "Stripe", "group": "tools", "icon": "color/stripe.svg", "tier": "mcp", "phase": 1, "verified": true, "note": "A restricted API key is safest.", "connect": { "kind": "remote-mcp", "auth": "header", "url": "https://mcp.stripe.com", "fields": ["token"], "helpUrl": "https://dashboard.stripe.com/apikeys", "source": "https://docs.stripe.com/mcp" } },
    { "id": "supabase", "name": "Supabase", "group": "tools", "icon": "color/supabase.svg", "tier": "mcp", "phase": 1, "verified": true, "connect": { "kind": "remote-mcp", "auth": "header", "url": "https://mcp.supabase.com/mcp", "fields": ["token"], "helpUrl": "https://supabase.com/dashboard/account/tokens", "source": "https://supabase.com/docs/guides/ai-tools/mcp" } },
    { "id": "context7", "name": "Context7", "group": "tools", "icon": "color/context7.png", "tier": "mcp", "phase": 1, "verified": true, "note": "Up-to-date library docs for your agents.", "connect": { "kind": "remote-mcp", "auth": "none", "url": "https://mcp.context7.com/mcp", "fields": [], "helpUrl": "https://context7.com", "source": "https://upstash.com/blog/context7-mcp" } },
    { "id": "playwright", "name": "Playwright", "group": "tools", "icon": "color/playwright.svg", "tier": "mcp", "phase": 1, "verified": true, "note": "Lets agents drive a browser.", "connect": { "kind": "local-mcp", "auth": "none", "command": "npx", "args": ["-y", "@playwright/mcp@latest"], "fields": [], "helpUrl": "https://github.com/microsoft/playwright-mcp", "source": "https://github.com/microsoft/playwright-mcp" } },
    { "id": "brave", "name": "Brave Search", "group": "tools", "icon": "color/brave.svg", "tier": "mcp", "phase": 1, "verified": true, "connect": { "kind": "local-mcp", "auth": "env", "command": "npx", "args": ["-y", "@brave/brave-search-mcp-server", "--transport", "stdio"], "env": { "BRAVE_API_KEY": "{apiKey}" }, "fields": ["apiKey"], "helpUrl": "https://api-dashboard.search.brave.com/app/keys", "source": "https://github.com/brave/brave-search-mcp-server" } }
